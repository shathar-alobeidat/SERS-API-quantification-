==============================================================================
# SERS QUANTITATIVE ANALYSIS & INDEPENDENT PNEC VALIDATION (IMATINIB - IMT)
# Method: Ordinary Least Squares (OLS).
IMT as an example: PNEC = 96 ppb, target peak: 1032 cm-1
PNEC for NTF is 1 ppb (1608 cm-1), for MID its 0.289 ppb (1593 cm-1/1000cm-1 internal standard normalization) 
# ==============================================================================


cal_files <- list.files(pattern = "\\.txt$", recursive = TRUE)
spc_cal <- lapply(cal_files, scan.txt.BWtek)
spc_cal <- collapse(spc_cal)
spc_cal$file <- cal_files

meta_cal <- strsplit(spc_cal$file, "_")
spc_cal$conc <- sapply(meta_cal, "[[", 11) 

# Preprocessing: LOESS smoothing & ALS baseline correction
spc_cal <- spc.loess(spc_cal, c(seq(350, 1800, 3)))
bl_cal  <- baseline(spc_cal[[]], method = "als", lambda = 4, p = 0.005, maxit = 100)
spc_cal[[]] <- getCorrected(bl_cal)

# Feature extraction at 1032 cm^-1
cal_data <- data.frame(
  conc = as.numeric(spc_cal$conc),
  response = spc_cal[, , 1032]$spc
)

blank_data   <- cal_data[cal_data$conc == 0, ]
sd_blank     <- sd(blank_data$response)

cal_data_fit <- cal_data[cal_data$conc > 0, ] # Filter out 0 ppb to prevent leverage distortion

# Fit OLS across calibration range
model_ols     <- lm(response ~ conc, data = cal_data_fit)
slope_ols     <- coef(model_ols)[2]
intercept_ols <- coef(model_ols)[1]
se_slope_ols  <- summary(model_ols)$coefficients[2, "Std. Error"]
se_int_ols    <- summary(model_ols)$coefficients[1, "Std. Error"]
Sy_x_ols      <- summary(model_ols)$sigma
r_squared_ols <- summary(model_ols)$r.squared

# Metric Evaluations
x_theo     <- cal_data_fit$conc
x_meas_ols <- (cal_data_fit$response - intercept_ols) / slope_ols
re_ols     <- calc_re(x_meas_ols, x_theo)

LOD_blank_ols  <- 3.3 * sd_blank / slope_ols
LOQ_blank_ols  <- 10.0 * sd_blank / slope_ols
LOD_hubaux_ols <- 3.3 * Sy_x_ols / slope_ols

# ==============================================================================
  # Model Diagnostics
# ==============================================================================

cat("[2/4] Computing Model Diagnostics...\n")

cal_data_fit$calc_conc <- (cal_data_fit$response - intercept_ols) / slope_ols
cal_data_fit$recovery  <- (cal_data_fit$calc_conc / cal_data_fit$conc) * 100
cal_data_fit$rel_error <- ((cal_data_fit$calc_conc - cal_data_fit$conc) / cal_data_fit$conc) * 100
cal_data_fit$std_resid <- rstandard(model_ols) # Statistically rigorous standardized residuals

# ==============================================================================
 # Independent Validation at PNEC Threshold (96 ppb)
# ==============================================================================

cat("[3/4] Processing Independent Dataset...\n")

val_dir <- "C:/path to validation set"

val_files <- list.files(path = val_dir, pattern = "\\.txt$", full.names = TRUE)
if(length(val_files) == 0) {
  warning("Validation directory path empty or missing. Check 'val_dir'.")
} else {
  spc_val <- lapply(val_files, scan.txt.BWtek)
  spc_val <- collapse(spc_val)
  spc_val$file <- basename(val_files)
  
  meta_val <- strsplit(spc_val$file, "_")
  spc_val$nominal_conc <- as.numeric(sapply(meta_val, "[[", 11))
  
  spc_val <- spc.loess(spc_val, c(seq(350, 1800, 3)))
  bl_val  <- baseline(spc_val[[]], method = "als", lambda = 4, p = 0.005, maxit = 100)
  spc_val[[]] <- getCorrected(bl_val)
  
  val_data <- data.frame(
    file = spc_val$file,
    nominal_conc = spc_val$nominal_conc,
    response = spc_val[, , 1032]$spc
  )
  
  pnec_threshold <- 96.0 ##change according to target PNEC
  val_data$predicted_conc <- (val_data$response - intercept_ols) / slope_ols
  
  val_data$actual_class <- factor(ifelse(val_data$nominal_conc >= pnec_threshold, "Above 96 ppb", "Below 96 ppb"),
                                  levels = c("Below 96 ppb", "Above 96 ppb"))
  val_data$pred_class   <- factor(ifelse(val_data$predicted_conc >= pnec_threshold, "Above 96 ppb", "Below 96 ppb"),
                                  levels = c("Below 96 ppb", "Above 96 ppb"))
  
  confusion_matrix <- table(Actual = val_data$actual_class, Predicted = val_data$pred_class)
  
  TP <- confusion_matrix["Above 96 ppb", "Above 96 ppb"]
  TN <- confusion_matrix["Below 96 ppb", "Below 96 ppb"]
  FP <- confusion_matrix["Below 96 ppb", "Above 96 ppb"]
  FN <- confusion_matrix["Above 96 ppb", "Below 96 ppb"]
  
  accuracy    <- (TP + TN) / sum(confusion_matrix) * 100
  sensitivity <- TP / (TP + FN) * 100
  specificity <- TN / (TN + FP) * 100
}


cat("\n========================================================\n")
cat("           OLS CAL MODEL PERFORMANCE REPORT          \n")
cat("========================================================\n")
cat(sprintf("Slope (b1):          %.6g (SE = %.4g)\n", slope_ols, se_slope_ols))
cat(sprintf("Intercept (b0):      %.6g (SE = %.4g)\n", intercept_ols, se_int_ols))
cat(sprintf("Residual Sy/x:       %.4g\n", Sy_x_ols))
cat(sprintf("R-squared:           %.3f\n", r_squared_ols))
cat(sprintf("Mean Abs %%RE:        %.2f%%\n", re_ols["aver"]))
cat(sprintf("Max Abs %%RE:         %.2f%%\n", re_ols["max"]))
cat(sprintf("Blank SD LOD:        %.4g ppb\n", LOD_blank_ols))
cat(sprintf("Blank SD LOQ:        %.4g ppb\n", LOQ_blank_ols))
cat(sprintf("Hubaux-Vos LOD:      %.4g ppb\n", LOD_hubaux_ols))

if (exists("val_data")) {
  cat("\n========================================================\n")
  cat("     INDEPENDENT VALIDATION REPORT       \n")
  cat("========================================================\n")
  print(confusion_matrix)
  cat(sprintf("\nAccuracy:    %.2f%%\n", accuracy))
  cat(sprintf("Sensitivity: %.2f%%\n", sensitivity))
  cat(sprintf("Specificity: %.2f%%\n", specificity))
}


x_grid <- seq(min(cal_data_fit$conc) - 5, max(cal_data_fit$conc) + 10, length.out = 300)
pred_conf <- predict(model_ols, newdata = data.frame(conc = x_grid), interval = "confidence", level = 0.95)
pred_interval <- predict(model_ols, newdata = data.frame(conc = x_grid), interval = "prediction", level = 0.95)

summary_means <- aggregate(response ~ conc, data = cal_data_fit, FUN = mean)
y_max <- max(c(cal_data_fit$response, pred_interval[, "upr"])) * 1.05

n_reps <- table(cal_data_fit$conc)[1]

plot(1, type = "n",
     xlim = c(min(cal_data_fit$conc) - 5, max(cal_data_fit$conc) + 5),
     ylim = c(0, y_max),
     xlab = "Concentration (ppb)",
     ylab = expression(paste("Intensity at 1032 ", cm^-1)),
     main = "")

polygon(c(x_grid, rev(x_grid)),
        c(pred_conf[, "lwr"], rev(pred_conf[, "upr"])),
        col = "gray85", border = NA)

lines(x_grid, pred_interval[, "lwr"], lty = 2, col = "black", lwd = 1.2)
lines(x_grid, pred_interval[, "upr"], lty = 2, col = "black", lwd = 1.2)
abline(model_ols, col = "black", lwd = 2)

points(cal_data_fit$conc, cal_data_fit$response, pch = 19, col = "gray50", cex = 1.1)
points(summary_means$conc, summary_means$response, pch = 19, col = "black", cex = 1.3)

sign_str <- ifelse(intercept_ols >= 0, "+", "-")
eq_text  <- sprintf("y = %.1f x %s %.0f", slope_ols, sign_str, abs(intercept_ols))
r2_text  <- sprintf("R^2 = %.3f", r_squared_ols)
rep_text <- sprintf("Replicates (n = %d)", n_reps)

legend("topleft",
       legend = c(rep_text,
                  "Mean",
                  "Linear fit",
                  "95 % confidence band",
                  "95 % prediction band",
                  eq_text,
                  r2_text),
       pch = c(19, 19, NA, 15, NA, NA, NA),
       pt.cex = c(1.1, 1.3, NA, 2.0, NA, NA, NA),
       col = c("gray50", "black", "black", "gray85", "black", NA, NA),
       lty = c(NA, NA, 1, NA, 2, NA, NA),
       lwd = c(NA, NA, 2, NA, 1.2, NA, NA),
       bty = "n",
       cex = 0.95)


