spc[[]]    <- getCorrected(bl)

# Signal intensity per replicate
intensities_all <- as.vector(spc[,, ANALYTE_PEAK]$spc)
y_range         <- range(y_train)      

for (sid in unique(spc$type)) {
  idx         <- which(spc$type == sid)
  intensities <- intensities_all[idx]
  
  conc_each <- sapply(intensities, function(r) wls.inverse.predict(calibration, r)$estimate)
  pred <- wls.inverse.predict(calibration, intensities, level = 0.95)
  
