##this script contains unknown predictions data analysis pipeline via OLS and WLS, using internal standard and without.
# Set the working directory to the training set to build the calibration model used for prediction 
setwd("C:/path to training set")   
spectra_files <- list.files(pattern = "\\.txt$", recursive = TRUE)
if (length(spectra_files) == 0) stop("No .txt files found for training set.")
spc      <- lapply(spectra_files, scan.txt.BWtek)
spc      <- collapse(spc)
spc$file <- spectra_files
meta     <- strsplit(spc$file, "_")
spc$conc <- sapply(meta, "[[", 11)
# Preprocessing
spc        <- spc.loess(spc, c(seq(350, 1800, 3)))
bl         <- baseline(spc[[]], method = "als", lambda = 4, p = 0.005, maxit = 100)
spc[[]]    <- getCorrected(bl)

# Peak wavenumbers —  (MID as an example)
ANALYTE_PEAK <- 1593   # analyte peak (cm-1)
IS_PEAK      <-1000 # internal standard peak (cm-1)

# Peak ratio

ana <- as.numeric(spc[,, ANALYTE_PEAK]$spc)
is  <- as.numeric(spc[,, IS_PEAK]$spc)
response_ratio <- ana / is          # element-wise; no mean()
x_train <- as.numeric(spc$conc)
y_train <- as.vector(response_ratio)
calibration <- lm(y_train ~ x_train)
cat("\n--- Calibration Model ---\n")
print(summary(calibration))
trainspc <- spc





# UNKNOWN SAMPLES 

# All unknown .txt files in one folder. Replicates are grouped into samples by the
# "type" label read from the filename (i.e. campioneB, campioneC, mixture1, mixture 2).

setwd("C:/path holding the unknown mixtures files named according to the metadata naming convention")           
spectra_files <- list.files(pattern = "\\.txt$", recursive = TRUE)
if (length(spectra_files) == 0) stop("No .txt files found for unknown set.")
spc      <- collapse(lapply(spectra_files, scan.txt.BWtek))
spc$file <- spectra_files
meta     <- strsplit(spc$file, "_")

# Sample type from the filename 
TYPE_FIELD <- 10                     
spc$type   <- sapply(meta, "[[", TYPE_FIELD)

# Preprocessing 
spc        <- spc.loess(spc, c(seq(350, 1800, 3)))
bl         <- baseline(spc[[]], method = "als", lambda = 4, p = 0.005, maxit = 100)
spc[[]]    <- getCorrected(bl)

# Peak ratio per replicate
ratios_all <- as.vector(spc[,, ANALYTE_PEAK]$spc / mean(spc[,, IS_PEAK]$spc))
y_range    <- range(y_train)            # calibration response range (extrapolation check)


for (sid in unique(spc$type)) {
  idx    <- which(spc$type == sid)
  ratios <- ratios_all[idx]
  
  # per-replicate predicted concentrations
  conc_each <- sapply(ratios, function(r) inverse.predict(calibration, r)$Prediction)
  
  # pooled prediction: passing all replicate ratios makes chemCal treat
  # them as replicates of one sample and return a CI that accounts for m
  pred <- inverse.predict(calibration, ratios)
  cl   <- pred[["Confidence Limits"]]
  
  cat(sprintf("\nSample '%s'  (n = %d replicates)\n", sid, length(ratios)))
  cat("  Peak ratios     :", paste(round(ratios, 4),    collapse = ", "), "\n")
  cat("  Conc / replicate:", paste(round(conc_each, 4), collapse = ", "), "\n")
  cat(sprintf("  Concentration   : %.4f\n", pred$Prediction))
  cat(sprintf("  Standard error  : %.4f\n", pred[["Standard Error"]]))
  cat(sprintf("  95%% CI          : [%.4f, %.4f]\n", cl[1], cl[2]))
  if (mean(ratios) < y_range[1] || mean(ratios) > y_range[2])
    cat("  WARNING: mean response is OUTSIDE the calibration range -> extrapolated.\n")
}



